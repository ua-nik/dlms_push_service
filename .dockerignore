# Типово все виключено; Docker отримує лише вихідний код і файли для збирання.
**
!Dockerfile
!.dockerignore
!requirements.txt
!manage.py
!entrypoint.sh
!apps/
!apps/**
!config/
!config/**
!scripts/
!scripts/**

# Додатковий захист від секретів, випадково доданих до дозволених каталогів.
**/.env
**/.env.*
**/*.before-android-ip
**/*.bak
**/*.backup
**/*~
**/*.key
**/*.pem
**/*.crt
**/*.p12
**/*.pfx
**/*.jks
**/*.keystore
**/certs
**/certs/**
**/secrets
**/secrets/**
**/credentials*.json
**/*service-account*.json
**/.git
**/.git/**
**/__pycache__
**/__pycache__/**
**/*.pyc
**/*.pyo
**/*.log
**/*.sqlite3
