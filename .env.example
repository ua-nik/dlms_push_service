# ==============================================================================
# Сервіс NIK DLMS Push — файл налаштувань (.env)
# ==============================================================================
# Цей файл містить усі основні параметри для розгортання та роботи сервісу.
# Скопіюйте цей файл у `.env` та налаштуйте під ваше оточення:
#   cp .env.example .env
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Основні налаштування Django та безпеки
# ------------------------------------------------------------------------------
# Секретний ключ Django. ОБОВ'ЯЗКОВО змініть для промислової експлуатації!
DJANGO_SECRET_KEY=change-this-in-production-to-a-secure-random-64-character-string

# Режим налагодження (True - лише для розробки, False - для промислової експлуатації)
DJANGO_DEBUG=False

# Дозволені хости (через кому). Вкажіть IP-адресу сервера або доменне ім'я
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,0.0.0.0

# Рівень логування: DEBUG, INFO, WARNING, ERROR, CRITICAL
LOG_LEVEL=INFO

# ------------------------------------------------------------------------------
# 2. Налаштування бази даних PostgreSQL
# ------------------------------------------------------------------------------
# За замовчуванням порти СКБД назовні НЕ публікуються (доступ лише всередині Docker-мережі)
DB_NAME=dlms_push_db
DB_USER=dlms_user
DB_PASSWORD=dlms_secure_password_replace_me
DB_HOST=db
DB_PORT=5432

# ------------------------------------------------------------------------------
# 3. Налаштування Redis (Channel Layer для WebSocket)
# ------------------------------------------------------------------------------
# За замовчуванням порти Redis назовні НЕ публікуються
REDIS_HOST=redis
REDIS_PORT=6379

# ------------------------------------------------------------------------------
# 4. Налаштування UDP-приймача DLMS Push
# ------------------------------------------------------------------------------
# Адреса та порт, які слухає UDP-приймач для повідомлень від лічильників по LTE
UDP_RECEIVER_HOST=0.0.0.0
UDP_RECEIVER_PORT=4000

# Максимальний розмір черги вхідних повідомлень (захист від переповнення пам'яті)
UDP_RECEIVER_QUEUE_SIZE=10000

# Кількість паралельних воркерів обробки черги пакетів в UDP-приймачі
UDP_RECEIVER_WORKERS=4

# Розмір буфера сокета UDP в байтах (за замовчуванням 4 МБ)
UDP_SOCKET_RCVBUF_BYTES=4194304

# ------------------------------------------------------------------------------
# 5. Ключі шифрування DLMS COSEM (Security Suite 0, AES-GCM-128)
# ------------------------------------------------------------------------------
# DLMS_DEFAULT_GLOBAL_KEY і DLMS_DEFAULT_AUTH_KEY необов’язкові, якщо в лічильнику
# попередньо не було налаштовано шифрування повідомлень: ці рядки можна не вказувати.
# Для приймання незашифрованих повідомлень залиште DLMS_ALLOW_UNENCRYPTED=True.
# Глобальний майстер-ключ шифрування (Block Cipher Key) - 16 байт (32 hex-символи або 16 ASCII)
# У тестовому середовищі за замовчуванням: MYDUMMYGLOBALKEY (4d5944554d4d59474c4f42414c4b4559)
DLMS_DEFAULT_GLOBAL_KEY=MYDUMMYGLOBALKEY

# Глобальний ключ автентифікації (Authentication Key) - 16 байт
DLMS_DEFAULT_AUTH_KEY=MYDUMMYGLOBALKEY

# Індивідуальні ключі для конкретних лічильників у форматі JSON (system_title у HEX -> ключі)
# Приклад: {"2F19229199164103": {"global_key": "HEX_OR_ASCII", "auth_key": "HEX_OR_ASCII"}}
DLMS_METER_KEYS_JSON={}

# ------------------------------------------------------------------------------
# 6. Налаштування веб-сервера та API
# ------------------------------------------------------------------------------
# Порт внутрішнього ASGI-сервера Daphne
API_PORT=8000

# HTTP-порт необов’язкового Nginx; HTTPS налаштовується на зовнішньому проксі
NGINX_HTTP_PORT=80


# Вмикайте лише в довіреній мережі для незашифрованих повідомлень DataNotification.
DLMS_ALLOW_UNENCRYPTED=True
